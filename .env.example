# =============================================================================
# SkillUp / EduQuiz - Muhit O'zgaruvchilari Shablon Fayli (.env.example)
# Haqiqiy sozlamalar uchun ushbu fayldan nusxa olib, nomini .env qilib saqlang.
# =============================================================================

# Django Sozlamalari
DEBUG=True
SECRET_KEY=django-insecure-your-secret-key-here-replace-in-production
ALLOWED_HOSTS=*

# Telegram Bot Integratsiyasi
# BotFather orqali olingan token va adminga bildirishnomalar boruvchi chat_id
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_ID=your_telegram_chat_id_here
